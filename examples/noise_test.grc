    author: Swarnava Ghosh
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: Swarnava Ghosh
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
